# Base de datos: la MISMA PostgreSQL alojada en Supabase (no se crea otra BD).
# El prefijo +psycopg (driver async) se añade automáticamente si usas postgresql://
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# App
APP_NAME=EnterpriseCloud API
ENVIRONMENT=development
PORT=8000
CORS_ORIGINS=http://localhost:5173

# JWT (se usará en la fase de autenticación)
JWT_SECRET=change-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
